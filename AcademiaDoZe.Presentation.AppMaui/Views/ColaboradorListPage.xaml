<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
             x:Name="ColaboradoresPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:ColaboradorListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        
        <DataTemplate x:Key="ColaboradorItemTemplate" x:DataType="dto:ColaboradorDto">
            <SwipeView>
                <SwipeView.RightItems>
                    <SwipeItems>
                        <SwipeItem Text="Editar" BackgroundColor="DodgerBlue" Command="{Binding BindingContext.EditColaboradorCommand, Source={x:Reference ColaboradoresPage}}" CommandParameter="{Binding .}" />
                        <SwipeItem Text="Excluir" BackgroundColor="Red" Command="{Binding BindingContext.DeleteColaboradorCommand, Source={x:Reference ColaboradoresPage}}" CommandParameter="{Binding .}" />
                    </SwipeItems>
                </SwipeView.RightItems>
                <Grid Padding="1" Margin="5">
                    <Border Style="{StaticResource CardBorder}" Margin="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12" VerticalOptions="Center">
                            <!-- Foto do Colaborador -->
                            <Border Grid.Column="0"
                                    HeightRequest="70" WidthRequest="70"
                                    StrokeShape="RoundRectangle 35"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                    VerticalOptions="Center">
                                <Image Source="{Binding Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                       Aspect="AspectFill" HeightRequest="70" WidthRequest="70" />
                            </Border>

                            <!-- Informações do Colaborador -->
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Cpf, StringFormat='CPF: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                <Label Text="{Binding Email}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" LineBreakMode="TailTruncation"/>
                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                    <Border Padding="6,2" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                                        <Label Text="{Binding Tipo}" FontSize="10" FontAttributes="Bold" TextColor="White"/>
                                    </Border>
                                    <Border Padding="6,2" StrokeShape="RoundRectangle 4" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}">
                                        <Label Text="{Binding Vinculo}" FontSize="10" TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"/>
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Botão de Ação -->
                            <Button Grid.Column="2"
                                    Text="Editar"
                                    Style="{StaticResource ButtonSecondary}"
                                    HeightRequest="36"
                                    Command="{Binding BindingContext.EditColaboradorCommand, Source={x:Reference ColaboradoresPage}}"
                                    CommandParameter="{Binding .}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </SwipeView>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Search Bar com Debounce -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="15,10">
            <Grid ColumnDefinitions="Auto,10,*,10,Auto" VerticalOptions="Center">
                <Picker Grid.Column="0" ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding SelectedFilterType}" WidthRequest="100" HeightRequest="40" VerticalOptions="Center"/>
                <Entry x:Name="SearchEntry"
                       Grid.Column="2"
                       Text="{Binding SearchText}"
                       TextChanged="OnSearchDebounceTextChanged"
                       Placeholder="Digite para buscar..."
                       HeightRequest="40"
                       VerticalOptions="Center"
                       ClearButtonVisibility="WhileEditing"
                       ReturnCommand="{Binding SearchColaboradoresCommand}" />
                <Button Grid.Column="4" Style="{StaticResource ButtonPrimary}" WidthRequest="50" HeightRequest="40" Command="{Binding SearchColaboradoresCommand}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <!-- Lista e FAB -->
        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Colaboradores}"
                                ItemTemplate="{StaticResource ColaboradorItemTemplate}"
                                SelectionMode="None"
                                Margin="10">
                    <CollectionView.EmptyView>
                        <StackLayout VerticalOptions="Center">
                            <Label Text="Nenhum colaborador encontrado" HorizontalOptions="Center" Style="{StaticResource SubHeadline}"/>
                            <Button Text="Adicionar Colaborador" Command="{Binding AddColaboradorCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="44" Margin="0,16,0,0"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <!-- FAB -->
            <Button Command="{Binding AddColaboradorCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    WidthRequest="56"
                    HeightRequest="56"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="20">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=Black, Dark=Gray}" Offset="0,4" Radius="8" Opacity="0.3"/>
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>

