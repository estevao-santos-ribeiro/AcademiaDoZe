<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:DashboardListViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="24" Padding="32,24" MaximumWidthRequest="1300" HorizontalOptions="CenterAndExpand">

            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="Painel Principal 👋" 
                           FontSize="13" 
                           FontFamily="OpenSansRegular"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    <Label Text="Academia do Zé" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="14" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 22"
                            HeightRequest="44"
                            WidthRequest="260"
                            Padding="14,0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                            <Label Grid.Column="0" 
                                   Text="&#xe8b6;" 
                                   FontFamily="MaterialIcons" 
                                   FontSize="18" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}" 
                                   VerticalOptions="Center"/>
                            <Entry Grid.Column="1" 
                                   Placeholder="Buscar no sistema..." 
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"/>
                        </Grid>
                    </Border>

                    <Border StrokeShape="RoundRectangle 20"
                            Padding="12,6"
                            BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}"
                            Stroke="{AppThemeBinding Light=#A7F3D0, Dark=#065F46}"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                        <Label Text="🟢 Academia Aberta" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#047857, Dark=#6EE7B7}"
                               VerticalOptions="Center"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 22"
                            HeightRequest="44"
                            WidthRequest="44"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Label Text="&#xe7fd;" 
                               FontFamily="MaterialIcons" 
                               FontSize="22" 
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <Border StrokeShape="RoundRectangle 24"
                    Padding="28,24"
                    BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#1E293B}"
                    Stroke="{AppThemeBinding Light=#FED7AA, Dark=#334155}"
                    StrokeThickness="1">
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#FDBA74, Dark=#000000}" 
                            Offset="0,6" 
                            Radius="20" 
                            Opacity="0.18"/>
                </Border.Shadow>

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            StrokeShape="RoundRectangle 20"
                            WidthRequest="120"
                            HeightRequest="120"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                            Stroke="{AppThemeBinding Light=#FED7AA, Dark=#475569}"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                        <Image Source="academiadoze.png" 
                               Aspect="AspectFit"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center"/>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="6" Margin="24,0,20,0" VerticalOptions="Center">
                        <Border Padding="10,3" 
                                BackgroundColor="{AppThemeBinding Light=#FFEDD5, Dark=#332211}" 
                                Stroke="{AppThemeBinding Light=#FDBA74, Dark=#7C2D12}" 
                                StrokeShape="RoundRectangle 6" 
                                HorizontalOptions="Start"
                                VerticalOptions="Center">
                            <Label Text="SISTEMA DE GESTÃO ESPORTIVA" 
                                   FontSize="11" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#C2410C, Dark=#FB923C}"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Border>

                        <Label Text="Academia do Zé" 
                               FontSize="26" 
                               FontAttributes="Bold" 
                               FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>

                        <Label Text="De teus pulos • Gestão Integrada de Treinos, Membros e Matrículas" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>

                        <Label Text="Acompanhe o crescimento da academia, vigência de planos e informações cadastrais em um só lugar." 
                               FontSize="12" 
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="Nova Matrícula ➜" 
                            Command="{Binding NavigateToNovaMatriculaCommand}" 
                            Style="{StaticResource ButtonPrimary}" 
                            CornerRadius="23" 
                            HeightRequest="46" 
                            Padding="22,0" 
                            VerticalOptions="Center">
                        <Button.Shadow>
                            <Shadow Brush="{AppThemeBinding Light=#EA580C, Dark=#000000}" 
                                    Offset="0,4" 
                                    Radius="10" 
                                    Opacity="0.25"/>
                        </Button.Shadow>
                    </Button>
                </Grid>
            </Border>

            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="20" ColumnSpacing="20">

                <Border Grid.Row="0" Grid.Column="0" 
                        Style="{StaticResource CardBorder}" 
                        StrokeShape="RoundRectangle 22"
                        Padding="24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}"/>
                    </Border.GestureRecognizers>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                                Offset="0,4" 
                                Radius="16" 
                                Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 6" 
                                    Padding="10,3" 
                                    BackgroundColor="{AppThemeBinding Light=#FFF7ED, Dark=#332211}" 
                                    Stroke="{AppThemeBinding Light=#FED7AA, Dark=#7C2D12}" 
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="MEMBROS ATIVOS" 
                                       FontSize="10" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#EA580C, Dark=#FB923C}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 18" 
                                    HeightRequest="38" 
                                    WidthRequest="38" 
                                    BackgroundColor="{AppThemeBinding Light=#FFEDD5, Dark=#332211}" 
                                    StrokeThickness="0">
                                <Label Text="&#xe7fd;" 
                                       FontFamily="MaterialIcons" 
                                       FontSize="20" 
                                       TextColor="{AppThemeBinding Light=#EA580C, Dark=#FB923C}"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalAlunos}" 
                                   FontSize="38" 
                                   FontAttributes="Bold" 
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Alunos Cadastrados" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Gestão completa de dados pessoais, foto, CPF e histórico de treino." 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </VerticalStackLayout>

                        <Label Text="Gerenciar alunos ➜" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#EA580C, Dark=#FB923C}"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" 
                        Style="{StaticResource CardBorder}" 
                        StrokeShape="RoundRectangle 22"
                        Padding="24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}"/>
                    </Border.GestureRecognizers>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                                Offset="0,4" 
                                Radius="16" 
                                Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 6" 
                                    Padding="10,3" 
                                    BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#064E3B}" 
                                    Stroke="{AppThemeBinding Light=#A7F3D0, Dark=#065F46}" 
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="CONTRATOS E PLANOS" 
                                       FontSize="10" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#059669, Dark=#34D399}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 18" 
                                    HeightRequest="38" 
                                    WidthRequest="38" 
                                    BackgroundColor="{AppThemeBinding Light=#D1FAE5, Dark=#064E3B}" 
                                    StrokeThickness="0">
                                <Label Text="&#xefec;" 
                                       FontFamily="MaterialIcons" 
                                       FontSize="20" 
                                       TextColor="{AppThemeBinding Light=#059669, Dark=#34D399}"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalMatriculas}" 
                                   FontSize="38" 
                                   FontAttributes="Bold" 
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Matrículas Registradas" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Planos vigentes, restrições médicas, laudos anexados e vigência." 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </VerticalStackLayout>

                        <Label Text="Gerenciar matrículas ➜" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#059669, Dark=#34D399}"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" 
                        Style="{StaticResource CardBorder}" 
                        StrokeShape="RoundRectangle 22"
                        Padding="24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}"/>
                    </Border.GestureRecognizers>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                                Offset="0,4" 
                                Radius="16" 
                                Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 6" 
                                    Padding="10,3" 
                                    BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}" 
                                    Stroke="{AppThemeBinding Light=#BFDBFE, Dark=#1E40AF}" 
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="EQUIPE &amp; INSTRUTORES" 
                                       FontSize="10" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 18" 
                                    HeightRequest="38" 
                                    WidthRequest="38" 
                                    BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}" 
                                    StrokeThickness="0">
                                <Label Text="&#xea67;" 
                                       FontFamily="MaterialIcons" 
                                       FontSize="20" 
                                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalColaboradores}" 
                                   FontSize="38" 
                                   FontAttributes="Bold" 
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Colaboradores Ativos" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Instrutores, atendentes, administradores e dados de vínculo." 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </VerticalStackLayout>

                        <Label Text="Gerenciar equipe ➜" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" 
                        Style="{StaticResource CardBorder}" 
                        StrokeShape="RoundRectangle 22"
                        Padding="24">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}"/>
                    </Border.GestureRecognizers>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                                Offset="0,4" 
                                Radius="16" 
                                Opacity="0.06"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 6" 
                                    Padding="10,3" 
                                    BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#3B0764}" 
                                    Stroke="{AppThemeBinding Light=#DDD6FE, Dark=#581C87}" 
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="LOCALIDADES" 
                                       FontSize="10" 
                                       FontAttributes="Bold" 
                                       TextColor="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="Center"/>
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 18" 
                                    HeightRequest="38" 
                                    WidthRequest="38" 
                                    BackgroundColor="{AppThemeBinding Light=#EDE9FE, Dark=#3B0764}" 
                                    StrokeThickness="0">
                                <Label Text="&#xe7f1;" 
                                       FontFamily="MaterialIcons" 
                                       FontSize="20" 
                                       TextColor="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TotalLogradouros}" 
                                   FontSize="38" 
                                   FontAttributes="Bold" 
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Endereços &amp; Ruas" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
                            <Label Text="Base de logradouros, bairros, cidades e CEPs integrados." 
                                   FontSize="12" 
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                        </VerticalStackLayout>

                        <Label Text="Gerenciar logradouros ➜" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <ActivityIndicator IsVisible="{Binding IsBusy}" 
                               IsRunning="{Binding IsBusy}" 
                               Color="{StaticResource Primary}"
                               VerticalOptions="Center" 
                               HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
