<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroListPage"
             x:Name="LogradourosPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroListViewModel"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             Title="{Binding Title}">
    <Grid RowDefinitions="Auto,*">
        
        <Border Grid.Row="0" 
                Style="{StaticResource CardBorder}" 
                Margin="16,12,16,8"
                Padding="6">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                        Offset="0,2" 
                        Radius="8" 
                        Opacity="0.04"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                        Padding="8,0"
                        HeightRequest="42"
                        WidthRequest="130">
                    <Picker Title="" 
                            ItemsSource="{Binding FilterTypes}" 
                            SelectedItem="{Binding SelectedFilterType}" 
                            FontSize="13"
                            VerticalOptions="Center"/>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                        Padding="12,0"
                        HeightRequest="42">
                    <Entry Text="{Binding SearchText}" 
                           Placeholder="Digite o valor..." 
                           FontSize="13"
                           ClearButtonVisibility="WhileEditing"
                           ReturnCommand="{Binding SearchLogradourosCommand}"
                           VerticalOptions="Center"/>
                </Border>

                <Button Grid.Column="2" 
                        Command="{Binding SearchLogradourosCommand}" 
                        Style="{StaticResource ButtonPrimary}" 
                        HeightRequest="42" 
                        WidthRequest="46"
                        Padding="0"
                        CornerRadius="8">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe8b6;" Size="20" Color="White" />
                    </Button.ImageSource>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                         Command="{Binding RefreshCommand}"
                         Padding="16,6,16,16">
                
                <CollectionView ItemsSource="{Binding Logradouros}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         HorizontalItemSpacing="14"
                                         VerticalItemSpacing="14">
                            <GridItemsLayout.Span>
                                <OnIdiom x:TypeArguments="x:Int32">
                                    <OnIdiom.Phone>1</OnIdiom.Phone>
                                    <OnIdiom.Default>1</OnIdiom.Default>
                                    <OnIdiom.Tablet>2</OnIdiom.Tablet>
                                    <OnIdiom.Desktop>3</OnIdiom.Desktop>
                                    <OnIdiom.TV>4</OnIdiom.TV>
                                </OnIdiom>
                            </GridItemsLayout.Span>
                        </GridItemsLayout>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" 
                                             HorizontalOptions="Center"
                                             Spacing="14" 
                                             Padding="24">
                            <Label Text="Nenhum logradouro encontrado" 
                                   HorizontalOptions="Center" 
                                   Style="{StaticResource SubHeadline}"/>
                            <Button Text="Adicionar Primeiro Logradouro" 
                                    Command="{Binding AddLogradouroCommand}" 
                                    Style="{StaticResource ButtonPrimary}" 
                                    HeightRequest="46" 
                                    Padding="24,0"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LogradouroDto">
                            <Border Style="{StaticResource CardBorder}" 
                                    Padding="16"
                                    StrokeShape="RoundRectangle 16">
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" 
                                            Offset="0,3" 
                                            Radius="10" 
                                            Opacity="0.05"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                HorizontalOptions="Start"
                                                StrokeShape="RoundRectangle 6"
                                                Stroke="{AppThemeBinding Light={StaticResource CardStrokeLight}, Dark={StaticResource CardStrokeDark}}"
                                                StrokeThickness="1"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray900}}"
                                                Padding="8,2"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Id, StringFormat='ID: {0}'}" 
                                                   FontSize="11" 
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                                   VerticalTextAlignment="Center"/>
                                        </Border>

                                        <Button Grid.Column="1" 
                                                Clicked="OnEditButtonClicked"
                                                Style="{StaticResource ButtonSmall}"
                                                Padding="0"
                                                HeightRequest="32"
                                                WidthRequest="32"
                                                CornerRadius="6">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe3c9;" Size="16" />
                                            </Button.ImageSource>
                                        </Button>
                                        
                                        <Button Grid.Column="2" 
                                                Clicked="OnDeleteButtonClicked"
                                                Style="{StaticResource ButtonDanger}"
                                                Padding="0"
                                                HeightRequest="32"
                                                WidthRequest="32"
                                                CornerRadius="6">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe872;" Size="16" />
                                            </Button.ImageSource>
                                        </Button>
                                    </Grid>

                                    <Label Text="{Binding Nome}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" 
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"
                                           LineBreakMode="TailTruncation"/>

                                    <HorizontalStackLayout Spacing="6">
                                        <Border Padding="6,2" 
                                                StrokeShape="RoundRectangle 4" 
                                                BackgroundColor="{AppThemeBinding Light=#F5F3FF, Dark=#3B0764}"
                                                StrokeThickness="0">
                                            <Label Text="{Binding Bairro}" 
                                                   FontSize="11" 
                                                   TextColor="{AppThemeBinding Light=#7C3AED, Dark=#A78BFA}"
                                                   FontAttributes="Bold"/>
                                        </Border>
                                        <Border Padding="6,2" 
                                                StrokeShape="RoundRectangle 4" 
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Gray800}}"
                                                StrokeThickness="0">
                                            <Label Text="{Binding Cidade, StringFormat='{0}'}" 
                                                   FontSize="11" 
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                        </Border>
                                    </HorizontalStackLayout>

                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Grid.Column="0" 
                                               Text="{Binding Cep, StringFormat='CEP: {0}'}" 
                                               FontSize="12" 
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"/>
                                        <Label Grid.Column="1" 
                                               Text="{Binding Estado, StringFormat='UF: {0}'}" 
                                               FontSize="12" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <Button Command="{Binding AddLogradouroCommand}" 
                    Style="{StaticResource ButtonPrimary}" 
                    WidthRequest="56" 
                    HeightRequest="56" 
                    CornerRadius="28" 
                    Padding="0" 
                    HorizontalOptions="End" 
                    VerticalOptions="End" 
                    Margin="20">
                <Button.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=Black, Dark=Gray}" Offset="0,4" Radius="8" Opacity="0.3"/>
                </Button.Shadow>
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe145;" Size="24" Color="White" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <ActivityIndicator Grid.Row="0" Grid.RowSpan="2" 
                           IsVisible="{Binding IsBusy}" 
                           IsRunning="{Binding IsBusy}" 
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center" 
                           HorizontalOptions="Center"/>
    </Grid>
</ContentPage>
